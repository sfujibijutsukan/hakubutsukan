# Direct LAN access: set this to the server's LAN IP.
# Keep 127.0.0.1 when accessing through Caddy on the same host.
BIND_ADDRESS=127.0.0.1
PORT=8090

# Run: stat -c '%g' /var/run/docker.sock
DOCKER_GID=0
REFRESH_INTERVAL=15s

# Optional: a browser-accessible Dockge URL, e.g. http://192.168.1.10:5001
DOCKGE_URL=

# Optional Caddy deployment: create the DNS entry and use your existing network.
HAKUBUTSUKAN_DOMAIN=museum.example.test
CADDY_NETWORK=caddy

# Optional demo link; leave blank when no real service is configured.
DEMO_HANAFUDAKAN_URL=

# Optional: exact origins allowed for live exhibit previews (comma-separated).
PREVIEW_ORIGINS=
DEMO_GOURMETKAN_URL=
