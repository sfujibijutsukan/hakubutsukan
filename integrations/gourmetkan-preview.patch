diff --git a/internal/handlers/security_headers_test.go b/internal/handlers/security_headers_test.go
new file mode 100755
index 0000000..12eafb1
--- /dev/null
+++ b/internal/handlers/security_headers_test.go
@@ -0,0 +1,41 @@
+package handlers
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+)
+
+func TestPreviewEmbeddingAndReadOnlyMode(t *testing.T) {
+	next := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { w.WriteHeader(http.StatusOK) })
+	tests := []struct {
+		name, origin, method, path string
+		preview                    bool
+		want                       int
+	}{
+		{"default", "", "GET", "/", false, 200},
+		{"embedded preview", "http://localhost:8090", "GET", "/", true, 200},
+		{"preview blocks writes", "http://localhost:8090", "POST", "/restaurants", true, 403},
+		{"preview blocks login", "http://localhost:8090", "GET", "/auth/github/login", true, 403},
+		{"production permits routing", "", "POST", "/restaurants", false, 200},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			w := httptest.NewRecorder()
+			securityHeadersMiddleware(next, tt.origin, tt.preview).ServeHTTP(w, httptest.NewRequest(tt.method, tt.path, nil))
+			if w.Code != tt.want {
+				t.Fatalf("status %d", w.Code)
+			}
+			if tt.origin == "" {
+				if w.Header().Get("X-Frame-Options") != "DENY" || !strings.Contains(w.Header().Get("Content-Security-Policy"), "frame-ancestors 'none'") {
+					t.Fatal("default anti-framing changed")
+				}
+			} else {
+				if w.Header().Get("X-Frame-Options") != "" || !strings.Contains(w.Header().Get("Content-Security-Policy"), "frame-ancestors "+tt.origin+";") {
+					t.Fatal("incorrect allowed ancestor")
+				}
+			}
+		})
+	}
+}
