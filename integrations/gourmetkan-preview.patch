@@ -0,0 +1,25 @@
+package main
+
+import "testing"
+
+func TestPreviewConfig(t *testing.T) {
+	t.Setenv("GITHUB_CLIENT_ID", "")
+	t.Setenv("GITHUB_CLIENT_SECRET", "")
+	t.Setenv("PREVIEW_MODE", "false")
+	if _, err := loadConfig(); err == nil {
+		t.Fatal("production must require OAuth")
+	}
+	t.Setenv("PREVIEW_MODE", "true")
+	for _, origin := range []string{"http://localhost:8090", "https://museum.example.test/", ""} {
+		t.Setenv("EMBED_ORIGIN", origin)
+		if _, err := loadConfig(); err != nil {
+			t.Fatal(err)
+		}
+	}
+	for _, origin := range []string{"*", "http://user:pass@localhost:8090", "http://localhost:8090/path", "https://example.test; frame-ancestors *", "https://example.test?x=1"} {
+		t.Setenv("EMBED_ORIGIN", origin)
+		if _, err := loadConfig(); err == nil {
+			t.Errorf("accepted %q", origin)
+		}
+	}
+}
